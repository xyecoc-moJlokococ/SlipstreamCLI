<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <!-- Roboto is the platform sans on Android; Compose also loads bundled Roboto. -->
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/smugly_bg</item>
        <item name="android:colorAccent">@color/smugly_accent</item>
        <item name="android:textColorPrimary">@color/smugly_text_primary</item>
        <item name="android:textColorSecondary">@color/smugly_text_secondary</item>
        <!-- Android 15+ (targetSdk 35) forces edge-to-edge and ignores statusBarColor /
             navigationBarColor / setDecorFitsSystemWindows(true) unless this is set. The UI here
             is built around solid system bar backgrounds (see MainActivity#screenRoot), so opt
             back out of the forced edge-to-edge behavior. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
